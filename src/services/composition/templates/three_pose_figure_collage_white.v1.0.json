{
  "id": "three_pose_figure_collage_white",
  "version": "1.0",
  "status": "draft",
  "canvas": {
    "width": 800,
    "height": 800,
    "background": "#FFFFFF",
    "safe_margin": 0,
    "reserved_zones": []
  },
  "text_zones": [],
  "slots": [
    {
      "id": "rear_view_background",
      "role": "support",
      "required": true,
      "max_items": 1,
      "z_index": 10,
      "source_selection": {
        "product_match": "same_product",
        "expected_class": "figure",
        "view_type": ["rear", "back"],
        "framing": ["full", "three_quarter"],
        "prefer": ["清晰的背部细节", "完整的身体轮廓", "尽可能完整的腿部", "清晰度最高的源图"],
        "exclude": ["包装盒", "与其他槽位重复的源图", "只有背景而没有商品的图片"]
      },
      "closeup": {
        "viewport": [160, 0, 610, 770],
        "zoom": 1.0,
        "anchor": "top_center",
        "fit": "height",
        "center_x": 380,
        "clip_to_viewport": false
      }
    },
    {
      "id": "front_view_right",
      "role": "support",
      "required": true,
      "max_items": 1,
      "z_index": 20,
      "source_selection": {
        "product_match": "same_product",
        "expected_class": "figure",
        "view_type": ["front", "front_three_quarter"],
        "framing": ["full", "three_quarter"],
        "prefer": ["正面或斜前方站姿", "能够辨认人物面部", "服装和主体配色清晰", "与背面图姿态明显不同"],
        "exclude": ["与其他槽位重复的源图", "包装盒", "主体被严重遮挡的图片"]
      },
      "closeup": {
        "viewport": [430, 40, 800, 800],
        "zoom": 1.0,
        "anchor": "top_center",
        "fit": "height",
        "center_x": 650,
        "clip_to_viewport": false
      }
    },
    {
      "id": "action_pose_left_hero",
      "role": "hero",
      "required": true,
      "max_items": 1,
      "z_index": 30,
      "source_selection": {
        "product_match": "same_product",
        "expected_class": "figure",
        "view_type": ["dynamic", "front_three_quarter", "action"],
        "framing": ["closeup", "full", "three_quarter"],
        "prefer": ["攻击或飞行动作", "具有明显透视感", "头部和上半身清晰", "能够形成强烈的视觉冲击"],
        "exclude": ["与其他槽位重复的源图", "包装盒", "主体被文字遮挡严重的图片"]
      },
      "closeup": {
        "viewport": [0, 80, 680, 800],
        "zoom": 1.08,
        "anchor": "top_center",
        "fit": "height",
        "center_x": 250,
        "clip_to_viewport": false
      }
    }
  ],
  "rules": {
    "source_selection": {
      "same_product_required": true,
      "distinct_source_images_required": true,
      "allow_same_product_multiple_views": true,
      "deduplicate_near_identical_images": true,
      "prefer_pose_diversity": true
    },
    "background_removal": {
      "enabled": true,
      "method": "product_instance_segmentation",
      "preserve_original_product_pixels": true,
      "do_not_regenerate_product": true,
      "remove": [
        "scene_background",
        "floor",
        "clouds",
        "speech_bubble",
        "speech_bubble_text",
        "display_base",
        "display_stand",
        "legal_disclaimer",
        "source_image_watermarks"
      ],
      "preserve": ["toy_figure", "physically_attached_accessories", "product_effect_parts"],
      "preserve_translucent_accessories": true,
      "use_tight_alpha_bounds": true
    },
    "collage": {
      "allow_alpha_overlap": true,
      "prevent_alpha_overlap": false,
      "min_gap_px": 0,
      "allow_canvas_overflow": true,
      "clip_to_canvas": true,
      "render_order": ["rear_view_background", "front_view_right", "action_pose_left_hero"]
    },
    "hero_dominance": {
      "min_canvas_occupancy": 0.28,
      "target_canvas_occupancy": [0.35, 0.5],
      "measure": "visible_alpha_pixels_after_canvas_clip"
    },
    "figure_integrity": {
      "preserve_original_geometry": true,
      "preserve_original_colors": true,
      "no_ai_redrawing": true,
      "no_nonuniform_scaling": true,
      "allow_partial_canvas_crop": true
    },
    "fallback": {
      "allow_two_pose_degraded_candidate": true,
      "never_duplicate_same_source_to_fill_slot": true,
      "prefer_clear_distinct_views": true
    }
  }
}
